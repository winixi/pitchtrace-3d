{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "场迹 v2 媒体段曝光索引",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initSha256",
    "segmentSha256",
    "segmentBytes",
    "timeBase",
    "frames"
  ],
  "properties": {
    "initSha256": { "$ref": "#/definitions/sha256" },
    "segmentSha256": { "$ref": "#/definitions/sha256" },
    "segmentBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
    "timeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pts", "durationPts", "captureUtcUs"],
        "properties": {
          "pts": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "durationPts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "captureUtcUs": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          }
        }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
